{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/guest-cleanup",
      "schedule": "15 3 * * *"
    }
  ]
}